# --- Секреты и учётные данные -----------------------------------------------
# VoiceB хранит ключ OpenAI в %APPDATA%\VoiceB\apikey.bin (шифрование DPAPI),
# так что в чекауте его быть не должно. Правила ниже — страховка на случай,
# если ключ, .env или сертификат подписи окажутся в папке проекта.
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
*.crt
*.cer
apikey.bin
secrets.json
credentials.json
*.credentials
*_token
*.token
.npmrc
.netrc

# Локальные настройки приложения, если запуск шёл из чекаута
settings.json
history/

# --- Тяжёлые артефакты, которые приложение создаёт само ----------------------
# «Установить движок» в панели настроек пересоздаёт обе папки: venv Python
# и модели (~5 ГБ суммарно, HF_HOME указывает внутрь models/hf).
/models/
.venv-local/
.venv/
venv/

node_modules/

# --- Сборка ------------------------------------------------------------------
dist/
build/
out/
*.nsis.7z

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/

# --- Логи и временные файлы --------------------------------------------------
*.log
npm-debug.log*
tmp/
temp/

# --- ОС и редакторы ----------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
.vscode/
.idea/
*.swp
